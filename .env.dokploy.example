# ===========================================================
# Template Environment untuk Dokploy
# Salin isi ini ke tab "Environment" pada service Compose di Dokploy.
# JANGAN commit nilai asli ke git (ISO/IEC 27001 A.8.12 / A.5.17).
# Generate secret: openssl rand -hex 32
# ===========================================================

# ---------- Database (dipakai service db & app) ----------
POSTGRES_DB=ppv_stream
POSTGRES_USER=ppv
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ---------- Core ----------
BASE_URL=https://stream.example.com
RUST_LOG=info
TZ=Asia/Jakarta

# ---------- Security ----------
HMAC_SECRET=CHANGE_ME_64_HEX_CHARS
SESSION_TOKEN_TTL=3600

# ---------- Admin bootstrap (hapus/rotasi setelah admin pertama dibuat) ----------
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME_RANDOM_TOKEN
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- Upload & media ----------
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=1073741824
ALLOW_EXTS=mp4,mkv,mov,webm
HLS_SEGMENT_SECONDS=2
HWACCEL=none

# ---------- Currency & split ----------
# Kurs cadangan; kurs live diambil otomatis (lihat bagian FX di bawah).
DOLLAR_USD_TO_RUPIAH=16500
CREATOR_SPLIT_BP=9000

# ---------- Kurs & oracle harga token (FX) ----------
# Job latar: USD/IDR tiap FX_REFRESH_SECS, harga token native tiap FX_TOKEN_REFRESH_SECS.
# Admin bisa override di Admin > Settings > Exchange Rates.
FX_AUTO_REFRESH=1
FX_REFRESH_SECS=3600
FX_USD_IDR_URL=https://open.er-api.com/v6/latest/USD
FX_USD_IDR_JSON_POINTER=/rates/IDR
FX_USD_IDR_MIN=5000
FX_USD_IDR_MAX=50000
FX_MAX_CHANGE_PCT=10
FX_STALE_SECS=172800
FX_TOKEN_REFRESH_SECS=120
FX_TOKEN_MAX_CHANGE_PCT=30
FX_TOKEN_IDS=POL=polygon-ecosystem-token,MATIC=polygon-ecosystem-token,ETH=ethereum,WETH=ethereum
FX_TOKEN_OVERRIDE_MAX_AGE_SECS=86400
COINGECKO_API_KEY=

# ---------- Wallet deposit ----------
# Instruksi transfer yang tampil di wallet.html. Pakai \n untuk baris baru.
WALLET_DEPOSIT_INSTRUCTIONS=Bank: BCA\nNo. Rekening: 0000000000\na.n. PT Contoh\nCantumkan username Anda di berita transfer.

# ---------- Payment ----------
PAYMENT_PLUGINS=paypal,xendit
PAYMENT_DEFAULT_PROVIDER=paypal

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

XENDIT_ENV=test
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

STRIPE_ENV=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# ---------- x402 (opsional) — lihat docs/html/setup.html bagian "Setup kontrak" ----------
# ENABLE_WATCHER = build arg (kompilasi fitur watcher); WATCHER_ENABLE = saklar runtime.
ENABLE_WATCHER=0
# COMPOSE_PROFILES=watcher
X402_CONTRACT_ADDRESS=
X402_ADMIN_WALLET=
# Kunci penandatangan invoice. Wallet khusus, tanpa dana; simpan hanya di secret Dokploy.
X402_ADMIN_PRIVKEY=
X402_RPC_HTTP=
X402_RPC_WSS=
X402_CHAIN_ID=80002
X402_DEADLINE_SECS=900
WATCHER_ENABLE=0
# Hanya testnet: izinkan token non-stablecoin tanpa oracle (harga 1:1).
X402_ALLOW_VOLATILE_TOKENS=0
# Umur maksimum harga oracle untuk membuat invoice x402 token native.
X402_ORACLE_MAX_AGE_SECS=600

# ---------- Streaming ----------
# Jangan aktifkan di produksi: membuka /static_hls tanpa sesi.
ENABLE_STATIC_HLS=0

# ---------- S3-compatible storage (opsional) ----------
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PATH_STYLE=false
S3_PUBLIC_URL=

# ---------- Federation (opsional) ----------
FEDERATION_ENABLED=false
FEDERATION_DOMAIN=
FEDERATION_BASE_URL=
FEDERATION_ADMIN_TOKEN=
